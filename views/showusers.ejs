<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All users</title>
    <style>
        table,
        th,
        tr,
        td {
            border: 1px solid black;
        }
    </style>
</head>

<body>
    <form method="get" action="/user/addnew">
        <button>Add users</button>
    </form>
    <table>
        <tr>
            <th>Id</th>
            <th>UserName</th>
            <th>Email</th>
        </tr>
        <% for(user of result){ %>
            <tr>
                <td><%= user.id %></td>
                <td> <%= user.username %></td>
                <td><%= user.email %></td>
                <td>
                <form method="get" action="/user/<%=user.id %>/edit">
                    <button>Edit user data</button> 
                </form>
                </td>
                <td>
                <form method="get" action="/user/<%=user.id %>/delete">
                    <button>Delete user</button> 
                </form>
                </td>
            </tr>
            <%}%>
    </table>

</body>

</html>